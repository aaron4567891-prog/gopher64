import {
    Switch,
    ComboBox,
    Button,
    HorizontalBox,
    VerticalBox,
    GroupBox,
    Slider,
} from "std-widgets.slint";
import { Page } from "page.slint";
import { State } from "localgame_page.slint";

export struct ControlMapping { label: string, primary: int, alternate: int }

export global ControllerData {
    in-out property <int> mapping_port;
    in-out property <int> mapping_deadzone;
    in-out property <bool> mapping_legacy;
    in-out property <string> mapping_status;
    in-out property <[string]> mapping_choices;
    in-out property <[ControlMapping]> mapping_rows;
    in-out property <[bool]> controller_enabled;
    in-out property <[bool]> transferpak;
    in-out property <[string]> gb_rom_paths;
    in-out property <[string]> gb_ram_paths;
    in-out property <[int]> selected_profile_binding: [-1, -1, -1, -1];
    in-out property <[string]> input_profiles;
    in-out property <[string]> controller_names;
    in-out property <[string]> controller_paths;
    in-out property <[int]> selected_controller;
    in-out property <[bool]> controller_changed;
}

component ControllerPortLabel inherits Text {
    height: 32px;
    width: 36px;
    vertical-alignment: center;
    horizontal-alignment: center;
    font-weight: 600;
}

component ControllerFieldHeader inherits Text {
    height: 28px;
    horizontal-alignment: left;
    vertical-alignment: center;
    font-size: 13px;
}

component ControllerSettingsColumn inherits VerticalLayout {
    in property <string> title;
    in property <length> content-min-width: 0px;
    spacing: 6px;
    alignment: start;
    horizontal-stretch: 0;
    min-width: content-min-width > header.preferred-width ? content-min-width : header.preferred-width;

    header := ControllerFieldHeader {
        text: root.title;
    }

    @children
}

component ControllerSettingsCell inherits HorizontalLayout {
    height: 32px;
    alignment: start;

    @children
}

component ControllerSettingsGrid inherits HorizontalLayout {
    callback transferpak_toggled(int, bool);

    spacing: 12px;
    alignment: start;

    VerticalLayout {
        spacing: 6px;
        alignment: start;
        horizontal-stretch: 0;

        Rectangle {
            width: 36px;
            height: 28px;
        }

        for player[index] in [0, 1, 2, 3]: ControllerPortLabel {
            text: index + 1;
        }
    }

    ControllerSettingsColumn {
        title: @tr("ControllerSettingsGrid" => "Enabled");

        for player[index] in [0, 1, 2, 3]: ControllerSettingsCell {
            Switch {
                checked: ControllerData.controller_enabled[index];
                toggled => {
                    ControllerData.controller_enabled[index] = self.checked;
                }
            }
        }
    }

    ControllerSettingsColumn {
        title: @tr("ControllerSettingsGrid" => "Transfer Pak");

        for player[index] in [0, 1, 2, 3]: ControllerSettingsCell {
            Switch {
                checked: ControllerData.transferpak[index];
                toggled => {
                    ControllerData.transferpak[index] = self.checked;
                    root.transferpak_toggled(index, self.checked);
                }
            }
        }
    }

}

component ControllerAssignmentGrid inherits VerticalLayout {
    spacing: 6px;
    alignment: start;

    for player[index] in [0, 1, 2, 3]: HorizontalLayout {
        spacing: 8px;
        alignment: start;

        ControllerPortLabel {
            text: index + 1;
        }

        HorizontalLayout {
            alignment: start;

            ComboBox {
                horizontal-stretch: 0;
                min-width: self.preferred-width > 300px ? self.preferred-width : 300px;
                model: ControllerData.controller_names;
                current-index: ControllerData.selected_controller[index];
                selected => {
                    ControllerData.selected_controller[index] = self.current-index;
                    ControllerData.controller_changed[index] = true;
                }
            }
        }
    }
}

export component ControllerConfig inherits Page {
    callback mapping_port_changed(int);
    callback mapping_changed(int, int, int);
    callback mapping_deadzone_changed(int);
    callback auto_map_controller;
    callback input_profile_button_clicked;
    callback transferpak_toggled(int, bool);
    callback controller_window_created;
    title: @tr("Controller Configuration");

    init => {
        controller_window_created();
    }

    VerticalBox {
        spacing: 8px;
        alignment: start;

        GroupBox {
            title: @tr("Controller Settings");

            ControllerSettingsGrid {
                transferpak_toggled(index, enabled) => {
                    root.transferpak_toggled(index, enabled);
                }
            }
        }

        GroupBox {
            title: @tr("Controller Assignment");

            ControllerAssignmentGrid { }
        }
        GroupBox {
            title: @tr("Button Mapping");
            VerticalBox {
                HorizontalBox {
                    ComboBox {
                        model: [@tr("Player 1"), @tr("Player 2"), @tr("Player 3"), @tr("Player 4")];
                        current-index: ControllerData.mapping_port;
                        selected => {
                            ControllerData.mapping_port = self.current-index;
                            root.mapping_port_changed(self.current-index);
                        }
                    }
                    Button {
                        text: @tr("Auto-map Controller");
                        enabled: !State.game_running;
                        clicked => { root.auto_map_controller(); }
                    }
                }
                Text {
                    text: @tr("Choose the controller input for each N64 control. Auto-map replaces this player's bindings with the standard gamepad layout.");
                    wrap: word-wrap;
                }
                if ControllerData.mapping_legacy: Text {
                    text: @tr("Legacy raw joystick mapping is preserved. Use Auto-map to switch to standard gamepad inputs before editing.");
                    wrap: word-wrap;
                }
                Text { text: ControllerData.mapping_status; wrap: word-wrap; }
                HorizontalBox {
                    Text { text: @tr("Deadzone"); vertical-alignment: center; }
                    Slider {
                        maximum: 99;
                        value: ControllerData.mapping_deadzone;
                        enabled: !State.game_running;
                        changed(value) => { root.mapping_deadzone_changed(round(value)); }
                    }
                    Text { text: ControllerData.mapping_deadzone + "%"; }
                }
                for binding[index] in ControllerData.mapping_rows: VerticalBox {
                    Text { text: binding.label; }
                    ComboBox {
                        model: ControllerData.mapping_choices;
                        current-index: binding.primary;
                        enabled: !State.game_running && !ControllerData.mapping_legacy;
                        selected => { root.mapping_changed(index, 1, self.current-index); }
                    }
                    HorizontalBox {
                        Text { text: @tr("Alternate"); vertical-alignment: center; }
                        ComboBox {
                            model: ControllerData.mapping_choices;
                            current-index: binding.alternate;
                            enabled: !State.game_running && !ControllerData.mapping_legacy;
                            selected => { root.mapping_changed(index, 0, self.current-index); }
                        }
                    }
                }
            }
        }
    }
}
